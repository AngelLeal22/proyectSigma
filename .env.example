# Copia este archivo como ".env" y completa tus datos reales.
# ".env" no se sube al repositorio (ya está en .gitignore).

# Servidor SMTP de tu proveedor de correo (el que envía los avisos).
# Ejemplos comunes:
#   Google Workspace: smtp.gmail.com
#   Microsoft 365:    smtp.office365.com
#   cPanel/hosting:   mail.tudominio.com
SMTP_HOST=

# Puerto SMTP: 587 (STARTTLS, lo normal) o 465 (SSL directo)
SMTP_PORT=587

# true si usas el puerto 465 (SSL), false si usas 587 (STARTTLS)
SMTP_SECURE=false

# Cuenta de correo que ENVÍA el aviso (debe existir y tener permiso SMTP)
SMTP_USER=

# Contraseña de esa cuenta. Si el proveedor usa Google/Microsoft con 2FA,
# normalmente necesitas generar una "contraseña de aplicación", no la
# contraseña normal de la cuenta.
SMTP_PASS=

# A quién le llega el aviso de cada solicitud del formulario de contacto.
CONTACT_TO_EMAIL=Mercadeodigital@sigmapublicidad.com
